# Copy to .env for local development. Never commit the real file.

NODE_ENV=development
PORT=4200

# docker-compose.yml publishes Mongo on 27030 so it cannot collide with a
# default local mongod or another project's container.
MONGODB_URI=mongodb://127.0.0.1:27030/kreworx?directConnection=true

# Where the browser app is served from; used for CORS and Socket.io origins.
# Comma-separated, no trailing slashes.
CLIENT_ORIGIN=http://localhost:5200

# Signs session cookies. Any long random string; production must set its own.
JWT_SECRET=change-me

# One-click sign-in as the seeded demo staff, and a daily re-seed of the demo.
DEMO_MODE=true

# Where the browser opens its socket. Empty locally: Vite proxies it.
PUBLIC_API_URL=
